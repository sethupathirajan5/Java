class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        int row=grid.length;
        int col=grid[0].length;
        long tot=0;

        for(int i=0;i<row;i++) {
            for(int j=0;j<col;j++) {
                tot+=grid[i][j];
            }
        }

        if (tot % 2 != 0)
        {
             return false;
        }
        
        long tar = tot / 2;
        long hor = 0;
        
        for(int i = 0; i < row - 1; i++) {
            for(int j = 0; j < col; j++) {
                hor += grid[i][j];
            }
            if(hor == tar) return true;
        }
        
        long ver = 0;
        for(int j = 0; j < col - 1; j++) {
            for(int i = 0; i < row; i++) {
                ver += grid[i][j];
            }
            if(ver == tar) return true;
        }
        return false;
    }
}
